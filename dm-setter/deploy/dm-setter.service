# systemd unit for a VPS. Install:
#   sudo cp deploy/dm-setter.service /etc/systemd/system/ && sudo systemctl enable --now dm-setter
[Unit]
Description=Instagram DM setter
After=network-online.target

[Service]
User=setter
WorkingDirectory=/opt/dm-setter
ExecStart=/opt/dm-setter/setter-run serve --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
