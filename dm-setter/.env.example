# Copy to .env (gitignored). `./setter-run check` shows what is set and what is missing.

# --- required ---------------------------------------------------------------------------------------------
OPEN_ROUTER_API_KEY=               # openrouter.ai -> Keys (needs credit). The ONLY AI key: Claude, Jev guardrails, voice notes
IG_APP_ID=                         # Meta app -> Instagram -> API setup with Instagram login -> Instagram app ID
IG_APP_SECRET=                     # same page -> Instagram app secret (also verifies every webhook)
IG_VERIFY_TOKEN=                   # any random string; paste the same value in the webhook form
PUBLIC_BASE_URL=                   # https://setter.yourdomain.com (Meta only calls https)
ADMIN_PASSWORD=                    # the dashboard login (user: admin)

# --- safety switches --------------------------------------------------------------------------------------
DRY_RUN=1                          # 1 = nothing reaches Instagram, every reply lands as a "dry" draft
SETTER_ENABLED=1                   # 0 = global kill switch: the bot answers nobody
HUMAN_AGENT_ENABLED=0              # 1 only after Meta approves Human Agent: lets a PERSON reply up to 7 days

# --- optional ---------------------------------------------------------------------------------------------
NOTIFY_WEBHOOK_URL=                # Slack or Discord incoming webhook for handoffs, drafts, bookings
BOOKING_WEBHOOK_SECRET=            # random string; the booking tool posts to /hooks/booking/<this>

# --- tuning (defaults shown) ------------------------------------------------------------------------------
# REPLY_MODEL=anthropic/claude-sonnet-5.5   # writes every DM (OpenRouter model ids; claude-sonnet-5-5 also accepted)
# REPLY_EFFORT=low                 # low is right for chat; medium if replies feel shallow
# REPLY_THINKING=adaptive          # off = no thinking tokens at all (cheapest)
# CHEAP_MODEL=anthropic/claude-haiku-5.5    # summaries, photo descriptions, eval leads
# SYSTEM_CACHE_TTL=1h              # 1h suits a few chats an hour; 5m if a coach has constant traffic
# LLM_FALLBACKS=1                  # retry on another model if Claude declines or is down
# LLM_FALLBACK_MODEL=anthropic/claude-opus-4.8
# LLM_PROVIDER_ORDER=anthropic     # serve Claude from Anthropic first; Bedrock/Vertex only if it is down
# STT_MODEL=openai/whisper-large-v3-turbo   # voice notes (STT_API_URL + STT_API_KEY point elsewhere if you must)
# DEBOUNCE_SECONDS=20              # coach.yaml humanize.debounce_seconds wins
# HISTORY_KEEP=16                  # messages kept verbatim after a summary
# HISTORY_SUMMARIZE_AT=36          # summarise once a thread has this many live messages
# IG_GRAPH_VERSION=v23.0
# WORKERS=8
# COMMENT_POLL_MINUTES=10          # 0 = trust comment webhooks only
# JEV=off | JEV_INBOUND=shadow | JEV_OUTBOUND=shadow
