  "sourcing": {
    "max_per_run": 360,
    "resolve_domains": true,
    "resolve_query": "{name} {city} official website",
    "resolve_max": 800,
    "resolve_min_name_tokens": 2,
    "sources": [
      {
        "type": "gmaps",
        "depth": 10,
        "concurrency": 4,
        "require_category_match": true,
        "targets": [
          {
            "vertical": "clinic-gcc"
          },
          {
            "vertical": "salon-gcc"
          },
          {
            "vertical": "realestate-gcc"
          },
          {
            "vertical": "homeservices-gcc"
          },
          {
            "vertical": "restaurant-gcc"
          },
          {
            "vertical": "carservice-gcc"
          }
        ]
      },
      {
        "type": "overture",
        "max_candidates": 400,
        "targets": [
          {
            "vertical": "clinic"
          },
          {
            "vertical": "salon"
          },
          {
            "vertical": "realestate"
          },
          {
            "vertical": "homeservices"
          },
          {
            "vertical": "restaurant"
          },
          {
            "vertical": "carservice"
          }
        ]
      },
      {
        "type": "map",
        "targets": [
          {
            "selector": "\"amenity\"~\"clinic|dentist|doctors\"",
            "vertical": "clinic"
          },
          {
            "selector": "\"shop\"~\"beauty|hairdresser|massage\"",
            "vertical": "salon"
          },
          {
            "selector": "\"office\"=\"estate_agent\"",
            "vertical": "realestate"
          },
          {
            "selector": "\"craft\"~\"plumber|electrician|hvac\"",
            "vertical": "homeservices"
