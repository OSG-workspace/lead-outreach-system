            "vertical": "restaurant"
          },
          {
            "selector": "\"shop\"=\"car_repair\"",
            "vertical": "carservice"
          }
        ]
      },
      {
        "type": "places",
        "max_requests": 150,
        "targets": [
          {
            "included_type": "medical_clinic",
            "vertical": "clinic-gcc"
          },
          {
            "included_type": "hair_salon",
            "vertical": "salon-gcc"
          },
          {
            "included_type": "real_estate_agency",
            "vertical": "realestate-gcc"
          },
          {
            "included_type": "plumber",
            "vertical": "homeservices-gcc"
