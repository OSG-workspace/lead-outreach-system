# Comma-separated list of phone numbers (digits only, with country code) allowed
# to message the bridge. E.g. 14155551234,447700900123
# Leave empty to accept ALL inbound DMs (NOT recommended).
WHATSAPP_ALLOWED_NUMBERS=

# Path or command for the Claude Code CLI. Default: "claude"
CLAUDE_BIN=claude

# Extra args passed to every claude invocation. Useful options:
#   --dangerously-skip-permissions     run without per-tool prompts (only safe for solo use)
#   --model claude-opus-4-7             pin model
# Multiple args separated by spaces.
CLAUDE_EXTRA_ARGS=

# Max characters per WhatsApp message before splitting (WhatsApp limit ~4096).
WHATSAPP_CHUNK_SIZE=3500

# Hard timeout per Claude invocation (ms). Default 15 minutes — long enough for /find-leads.
CLAUDE_TIMEOUT_MS=900000
