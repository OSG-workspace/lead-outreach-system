# Copy this file to .env and fill in your real values
# Never commit .env

# ──────────────────────────────────────────────────────────────────────
# REQUIRED — for sending email
# ──────────────────────────────────────────────────────────────────────

# Brevo MCP — get from Brevo dashboard > SMTP & API > API Keys & MCP
# IMPORTANT: toggle "Create MCP server API key" when generating
BREVO_MCP_TOKEN=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Brevo sender — must be a verified sender in your Brevo account
BREVO_SENDER_EMAIL=you@yourdomain.com
BREVO_SENDER_NAME=Your Name

# Physical postal address rendered in every email footer (CAN-SPAM requires one
# per commercial message). A live send WARNs, not halts, when this is unset.
BREVO_SENDER_ADDRESS=123 Example Street, City, Country

# ──────────────────────────────────────────────────────────────────────
# OPTIONAL — mirror the vault into a real Obsidian vault
# ──────────────────────────────────────────────────────────────────────

# The pipeline's memory lives at project/vault/lead-outreach/ and is created by
# tools/scripts/bootstrap_vault.sh, so the system runs fine with this unset.
# Set it only if you want the vault to BE a folder in your Obsidian vault so you
# can read the sent-log and edit the voice/ICP docs there.
# Absolute path to your vault root (leave blank to keep the local copy only):
OBSIDIAN_VAULT_PATH=

# ──────────────────────────────────────────────────────────────────────
# OPTIONAL — Stage 2 sourcing via Google Places
# ──────────────────────────────────────────────────────────────────────

# Only needed by fixtures whose sourcing.json declares a {"type": "places"}
# source. OpenStreetMap indexes PREMISES, so ICPs without a shopfront (mobile
# trades, mobile services) are almost absent from it: measured 2026-08-03, all
# of Australia holds 161 trade websites in OSM, which the au-trades campaign
# exhausted in four fires. Google Places indexes those businesses because they
# create a Business Profile to get called.
#
#   1. Google Cloud console -> enable "Places API (New)"
#   2. create an API key and restrict it to the Places API
#   3. paste it below
#
# $32/1000 requests (Pro tier, the default). Pro tier deliberately never
# requests the website/phone fields — Google's ToS treats only the place ID as
# storage-eligible indefinitely, and this pipeline persists what it sources
# forever, so Pro tier is chosen to have nothing non-compliant to store in the
# first place. Domains come from Stage 2.5 (resolve_domains.py) independently
# proving them against the business's own site instead. See resolve_tier() in
# tools/scripts/source_places.py before ever setting "tier": "enterprise" on a
# places source — that returns website/phone directly and is a real ToS
# tradeoff, not a free upgrade.
#
# Leave BLANK to run without it: a places source with no key reports no fresh
# ground and the run continues on its other sources. It never silently
# substitutes a different sourcing method.
GOOGLE_PLACES_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# CONFIG
# ──────────────────────────────────────────────────────────────────────

# Hard cap on emails sent per run (send_batch_brevo.py default: 1000)
MAX_EMAILS_PER_RUN=1000

# Path where the gosom Google Maps scraper binary lives (the primary Stage-2
# source, driven by tools/scripts/source_gmaps.py). Installed by tools/install.sh.
GMAPS_SCRAPER_PATH=./tools/google-maps-scraper

# Where replies should go. If unset, defaults to BREVO_SENDER_EMAIL.
# Useful when the sender domain has no MX yet (replies would otherwise bounce):
# point this at your real inbox, e.g. replies@yourdomain.com.
# Once MX is set up (e.g. via ImprovMX), unset this so threads stay clean.
BREVO_REPLY_TO=
